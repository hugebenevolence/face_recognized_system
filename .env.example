# Copy to .env to override defaults (all values are optional).
POSTGRES_USER=face
POSTGRES_PASSWORD=face
POSTGRES_DB=face
INTERNAL_TOKEN=change-me

# Video source: rtsp://..., /samples/demo.mp4 (file, looped), or v4l2:/dev/video0 (Linux webcam)
SOURCE_URI=rtsp://mediamtx:8554/cam1
CAMERA_ID=cam1

# buffalo_l (accurate, default on GPU) or buffalo_s (default on CPU, ~5x faster)
#MODEL_PACK=buffalo_s
# Cosine similarity needed to call a face "known" (ArcFace: ~0.35-0.5)
MATCH_THRESHOLD=0.40

# URL the *browser* uses to reach the backend
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
