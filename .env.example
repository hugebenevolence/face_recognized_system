# Copy to .env to override defaults (all values are optional).
POSTGRES_USER=face
POSTGRES_PASSWORD=face
POSTGRES_DB=face
INTERNAL_TOKEN=change-me

# Video source: an rtsp:// URL, or a video file under /samples (looped)
SOURCE_URI=rtsp://mediamtx:8554/cam1
CAMERA_ID=cam1

# Cosine similarity needed to call a face "known" (ArcFace: ~0.35-0.5)
MATCH_THRESHOLD=0.40

# Optional: also publish the annotated video as H.264 over RTSP, for example rtsp://mediamtx:8554/annotated
#RTSP_OUT_URL=

# URL the *browser* uses to reach the backend
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
