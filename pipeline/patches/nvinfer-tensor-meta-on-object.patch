# Fix for DeepStream 7.1 gst-nvinfer, gstnvinfer_meta_utils.cpp, attach_tensor_output_meta().
#
# Case: a secondary nvinfer on objects whose input tensor comes from nvdspreprocess
# (input-tensor-meta=1) with output-tensor-meta=1, as for an embedding model such as ArcFace.
# For each object nvinfer wraps the preprocess ROI (NvDsRoiMeta, owned by the preprocess batch
# meta) in one NVDS_ROI_META user meta and adds that same user meta to the frame AND to the
# object. When the buffer is released it is released twice, and its release function
# (release_user_meta_at_frame_level) also runs "delete roi_meta->object_meta" on the object,
# which belongs to the batch meta pool. Result: "double free or corruption" crashes.
# The classifier path (attach_metadata_classifier) has the same double attachment, which matches
# the unresolved NVIDIA forum report "Double Free or Corruption Crash with nvdspreprocess and
# SGIE nvinfer" (DeepStream 6.4 to 7.1).
#
# Fix: when the ROI is an object, attach the output tensor meta to the object only, which is
# where a regular secondary nvinfer puts it (Gst-nvinfer docs: NvDsInferTensorMeta is attached
# to each object's obj_user_meta_list). Frame-level ROIs keep the original behaviour.
# Applied in pipeline/Dockerfile to the source NVIDIA ships in the DeepStream image.
--- a/gstnvinfer_meta_utils.cpp
+++ b/gstnvinfer_meta_utils.cpp
@@ -539,7 +539,12 @@
     user_meta->base_meta.copy_func = copy_tensor_output_meta;
     user_meta->base_meta.batch_meta = batch_meta;
 
-    if (nvinfer->input_tensor_from_meta) {
+    if (nvinfer->input_tensor_from_meta && frame.obj_meta) {
+      /* Secondary inference on objects with the tensor from nvdspreprocess: attach the tensor
+       * meta to the object, as a regular secondary nvinfer does. (Upstream attaches one ROI
+       * user meta to both the frame and the object, so it is released twice.) */
+      nvds_add_user_meta_to_obj (frame.obj_meta, user_meta);
+    } else if (nvinfer->input_tensor_from_meta) {
       /* Attach tensor meta as part of ROI Meta */
       nvds_add_user_meta_to_roi (frame.roi_meta, user_meta);
       /* Attach ROI Meta to Frame Meta */
@@ -551,10 +556,6 @@
       user_meta->base_meta.copy_func = NULL;
       user_meta->base_meta.batch_meta = batch_meta;
       nvds_add_user_meta_to_frame (frame.frame_meta, user_meta);
-      /* if object is roi itself */
-      if (frame.obj_meta) {
-        nvds_add_user_meta_to_obj (frame.obj_meta, user_meta);
-      }
     } else if (nvinfer->process_full_frame) {
       nvds_add_user_meta_to_frame (frame.frame_meta, user_meta);
     } else {
